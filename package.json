{
  "name": "docker-browser-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "schema": "npm run build && tsx scripts/export-schema.ts",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ipaddr.js": "2.3.0",
    "playwright": "1.64.1",
    "proxy-chain": "3.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
